# =============================================================================
# MiniCommerce V10 — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:5432/minicommerce
READ_DATABASE_URL=                          # Optional: Read-replica connection URL (falls back to primary if empty)

# --- Database Connection Pool ---
DB_POOL_SIZE=15                             # SQLAlchemy async engine pool size
DB_MAX_OVERFLOW=10                          # Maximum overflow connections beyond pool_size
DB_POOL_RECYCLE=1800                        # Recycle connections after N seconds

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300                       # Product catalog cache TTL in seconds

# --- JWT Authentication ---
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15              # Short-lived access token TTL
REFRESH_TOKEN_EXPIRE_DAYS=7                 # Long-lived refresh cookie TTL

# --- CORS Origins ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# --- OpenTelemetry / Jaeger ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
